# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 커밋되지 않습니다)
#
#   cp .env.example .env
#
# 넥슨 오픈 API 키 — https://openapi.nexon.com 에서 무료 발급
# 파티모집현황/키워드 알림이 거뿔(월드 외침) API를 읽는 데 사용합니다.
NEXON_API_KEY=

# 문의하기 전송용 Discord 웹훅 URL (설정 → 문의하기 → 보내기)
# Discord 채널 설정 → 연동 → 웹후크에서 생성한 URL을 넣습니다.
INQUIRY_WEBHOOK_URL=
